{
  "area": "transparency",
  "source": "tests/test_rpc.py — opacity settings and the scroll hook",
  "note": "Read-only and no-op cases only: setting a real window's opacity would change the user's desktop.",
  "cases": [
    {
      "name": "opacity settings are keyed by process name",
      "note": "Contents depend on what the config directory was seeded with, so only the shape is pinned.",
      "steps": [
        {
          "method": "get_opacity_settings",
          "expect": { "ok": true, "result_types": { "settings": "object" } }
        }
      ]
    },
    {
      "name": "saving opacity settings acknowledges the write",
      "steps": [
        {
          "method": "save_opacity_settings",
          "params": { "settings": {} },
          "expect": { "ok": true, "result": { "saved": true } }
        }
      ]
    },
    {
      "name": "the visible window list is enumerable",
      "steps": [
        {
          "method": "list_windows",
          "expect": { "ok": true, "result_types": { "windows": "array" } }
        }
      ]
    },
    {
      "name": "the foreground window is reported as a handle",
      "steps": [
        {
          "method": "get_foreground_window",
          "expect": { "ok": true, "result_types": { "hwnd": "number" } }
        }
      ]
    },
    {
      "name": "scroll transparency reports its modifier vocabulary",
      "steps": [
        {
          "method": "scroll_transparency_status",
          "expect": {
            "ok": true,
            "result": { "modifiers": ["alt", "ctrl", "shift", "win"], "step": 5 },
            "result_types": {
              "running": "boolean",
              "modifier": "string",
              "available": "boolean",
              "enabled": "boolean"
            }
          }
        }
      ]
    },
    {
      "name": "syncing the scroll hook answers with the same shape as status",
      "steps": [
        {
          "method": "sync_scroll_transparency",
          "expect": {
            "ok": true,
            "result_types": {
              "running": "boolean",
              "modifier": "string",
              "available": "boolean",
              "enabled": "boolean",
              "modifiers": "array",
              "step": "number"
            }
          }
        }
      ]
    },
    {
      "name": "the all-windows fade reports what is installed",
      "steps": [
        {
          "method": "all_windows_opacity_status",
          "expect": {
            "ok": true,
            "result": { "running": false, "faded": 0, "enabled": false },
            "result_types": { "available": "boolean" }
          }
        }
      ]
    },
    {
      "name": "syncing the all-windows fade while it is off changes nothing",
      "note": "Only ever with all_windows=false: turning it on would fade the desktop of whoever runs the suite.",
      "steps": [
        {
          "method": "sync_all_windows_opacity",
          "params": { "config": { "transparency": { "all_windows": false, "all_windows_alpha": 128 } } },
          "expect": {
            "ok": true,
            "result": { "running": false, "faded": 0, "enabled": false },
            "result_types": { "available": "boolean" }
          }
        }
      ]
    },
    {
      "name": "the all-windows fade refuses a parameter it does not take",
      "steps": [
        {
          "method": "sync_all_windows_opacity",
          "params": { "alpha": 128 },
          "expect": { "ok": false, "error_type": "bad_params" }
        }
      ]
    }
  ]
}
